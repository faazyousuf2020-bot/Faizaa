{
  "expo": {
    "name": "Faizaa",
    "slug": "faizaa",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050816",
    "android": {
      "package": "com.poojiyam.faizaa",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#050816",
        "foregroundImage": "./android-icon-foreground.png",
        "monochromeImage": "./android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Faizaa reads your contacts so you can review and import them one letter at a time."
        }
      ]
    ]
  }
}